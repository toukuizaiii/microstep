<view class="stats-page"><view><view class="eyebrow">微小积累，也值得看见</view><view class="title">学习统计</view></view><view class="period-tabs"><view class="tab {{period==='week'?'active':''}}" data-period="week" bindtap="changePeriod">本周</view><view class="tab {{period==='month'?'active':''}}" data-period="month" bindtap="changePeriod">本月</view><view class="tab {{period==='all'?'active':''}}" data-period="all" bindtap="changePeriod">全部</view></view><view class="paper hero-stat"><view class="hero-label">累计学习</view><view><text class="hero-number">{{totalMinutes}}</text><text class="hero-unit"> 分钟</text></view><view class="hero-note">{{encouragement}}</view></view><view class="stat-grid"><view class="stat-item"><text class="stat-number">{{studyDays}}</text><text class="stat-label">学习天数</text></view><view class="stat-item"><text class="stat-number">{{recordCount}}</text><text class="stat-label">记录次数</text></view><view class="stat-item"><text class="stat-number">{{streak}}</text><text class="stat-label">连续天数</text></view></view><view class="category-section"><view class="section-title">时间都花在了哪里</view><view class="category-row" wx:for="{{categoryStats}}" wx:key="name"><view class="category-head"><text>{{item.name}}</text><text>{{item.minutes}} 分钟 · {{item.percent}}%</text></view><view class="bar-track"><view class="bar-fill color-{{index}}" style="width: {{item.percent}}%"></view></view></view><view class="empty" wx:if="{{!categoryStats.length}}">记录一次学习后，这里会长出你的统计。</view></view><view class="paper insight"><view class="insight-title">这一小步</view><view class="insight-copy">{{insight}}</view></view></view>
