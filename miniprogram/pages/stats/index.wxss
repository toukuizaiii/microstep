.stats-page{padding:34rpx}.eyebrow{color:#71866e;font-size:24rpx;letter-spacing:2rpx}.title{margin-top:8rpx;font-family:"STKaiti","KaiTi",serif;font-size:52rpx;font-weight:700}.period-tabs{display:flex;margin:32rpx 0 26rpx;padding:7rpx;border-radius:34rpx;background:#eee7da}.tab{flex:1;padding:14rpx 0;text-align:center;border-radius:28rpx;color:#7c766c;font-size:25rpx}.tab.active{background:#fffdf7;color:#e9684d;box-shadow:0 4rpx 12rpx rgba(70,55,35,.08)}.paper{background:#fffdf7;border-radius:26rpx;box-shadow:0 12rpx 28rpx rgba(74,61,43,.08)}.hero-stat{padding:42rpx 38rpx;background:#7e927b;color:#fffdf7}.hero-label{font-size:25rpx;opacity:.8}.hero-number{font-family:"STKaiti","KaiTi",serif;font-size:92rpx;font-weight:700}.hero-unit{font-size:27rpx}.hero-note{margin-top:8rpx;font-size:24rpx;opacity:.82}.stat-grid{display:flex;justify-content:space-between;margin:38rpx 0;padding:0 10rpx}.stat-item{display:flex;flex-direction:column;align-items:center;width:31%;border-right:1rpx solid rgba(86,74,53,.14)}.stat-item:last-child{border:0}.stat-number{font-family:"STKaiti","KaiTi",serif;font-size:50rpx;color:#e9684d}.stat-label{margin-top:5rpx;color:#7f796f;font-size:23rpx}.section-title{font-family:"STKaiti","KaiTi",serif;font-size:34rpx;font-weight:700}.category-row{margin-top:28rpx}.category-head{display:flex;justify-content:space-between;font-size:25rpx}.category-head text:last-child{color:#8e887d}.bar-track{height:14rpx;margin-top:12rpx;border-radius:10rpx;background:#e9e2d6;overflow:hidden}.bar-fill{height:100%;border-radius:10rpx;background:#7e927b}.color-1{background:#e9684d}.color-2{background:#c39b70}.color-3{background:#9a8ba7}.empty{padding:50rpx 0;text-align:center;color:#9b958b;font-size:26rpx}.insight{margin-top:38rpx;padding:30rpx}.insight-title{color:#71866e;font-size:24rpx}.insight-copy{margin-top:12rpx;font-family:"STKaiti","KaiTi",serif;font-size:30rpx;line-height:1.65}
