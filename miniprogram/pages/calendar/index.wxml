<view class="calendar-page"><view class="month-head"><view><view class="eyebrow">学习足迹</view><view class="month-title">{{year}}年 {{month}}月</view></view><view class="month-nav"><button bindtap="previousMonth">‹</button><button bindtap="nextMonth">›</button></view></view><view class="paper calendar-card"><view class="weekday-grid"><text wx:for="{{weekNames}}" wx:key="*this">{{item}}</text></view><view class="date-grid"><view class="date-cell {{item.isToday?'today':''}} {{item.selected?'selected':''}}" wx:for="{{days}}" wx:key="key" data-key="{{item.key}}" bindtap="selectDate"><text wx:if="{{item.day}}">{{item.day}}</text><view class="study-mark" wx:if="{{item.hasRecord}}"></view></view></view></view><view class="summary-strip"><view><text class="summary-number">{{monthDays}}</text><text> 学习天数</text></view><view><text class="summary-number">{{monthMinutes}}</text><text> 分钟</text></view></view><view class="selected-section"><view class="selected-title">{{selectedLabel}}</view><view class="empty" wx:if="{{!selectedRecords.length}}">这一天还没有留下学习记录</view><view class="record" wx:for="{{selectedRecords}}" wx:key="id"><view class="record-top"><text class="category">{{item.category}}</text><text class="duration">{{item.duration}} 分钟</text></view><view class="content">{{item.content}}</view><view class="time">{{item.createdTime}}</view></view></view></view>
