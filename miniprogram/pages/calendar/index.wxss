.calendar-page{padding:34rpx}.month-head,.month-nav,.summary-strip,.record-top{display:flex;align-items:center;justify-content:space-between}.eyebrow{color:#71866e;font-size:24rpx;letter-spacing:4rpx}.month-title{margin-top:8rpx;font-family:"STKaiti","KaiTi",serif;font-size:48rpx;font-weight:700}.month-nav{gap:14rpx}.month-nav button{width:72rpx;height:72rpx;line-height:66rpx;padding:0;border-radius:50%;background:#fffdf7;color:#6f7968;font-size:45rpx}.paper{background:#fffdf7;border-radius:26rpx;box-shadow:0 12rpx 28rpx rgba(74,61,43,.08)}.calendar-card{margin-top:34rpx;padding:28rpx 20rpx}.weekday-grid,.date-grid{display:grid;grid-template-columns:repeat(7,1fr)}.weekday-grid text{text-align:center;color:#918b80;font-size:23rpx}.date-grid{margin-top:18rpx;row-gap:12rpx}.date-cell{position:relative;height:72rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;font-size:27rpx}.date-cell.today{color:#e9684d;font-weight:600}.date-cell.selected{background:#7e927b;color:white}.study-mark{position:absolute;bottom:5rpx;width:8rpx;height:8rpx;border-radius:50%;background:#e9684d}.selected .study-mark{background:#fff}.summary-strip{margin:26rpx 0;padding:24rpx 32rpx;border-top:1rpx solid rgba(86,74,53,.12);border-bottom:1rpx solid rgba(86,74,53,.12);color:#777168}.summary-number{color:#e9684d;font-family:"STKaiti","KaiTi",serif;font-size:40rpx}.selected-title{font-family:"STKaiti","KaiTi",serif;font-size:34rpx;font-weight:700}.empty{padding:50rpx 0;text-align:center;color:#9b958b;font-size:27rpx}.record{margin-top:20rpx;padding:26rpx 28rpx;border-radius:22rpx;background:#fffdf7}.category{color:#71866e;font-size:23rpx}.duration{color:#e9684d;font-size:24rpx}.content{margin:16rpx 0;font-size:29rpx;line-height:1.6}.time{color:#9b958b;font-size:21rpx}
