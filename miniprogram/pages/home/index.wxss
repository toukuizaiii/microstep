.home{padding:calc(env(safe-area-inset-top) + 34rpx) 34rpx 48rpx;color:#292824}.header,.date-row,.week-head,.meta-row,.record-row{display:flex;align-items:center;justify-content:space-between}.brand{font-family:"STKaiti","KaiTi",serif;font-size:50rpx;font-weight:700;letter-spacing:3rpx}.brand-line{width:150rpx;height:5rpx;margin-top:3rpx;border-radius:5rpx;background:#7e927b;transform:rotate(-2deg)}.encourage{color:#70896d;font-family:"STKaiti","KaiTi",serif;font-size:27rpx;transform:rotate(-2deg)}.date-row{justify-content:flex-start;margin:52rpx 0 26rpx 12rpx}.date-main{font-family:"STKaiti","KaiTi",serif;font-size:54rpx;font-weight:700}.weekday{margin-left:22rpx;padding:7rpx 18rpx;border-radius:22rpx;background:#7e927b;color:#fffdf7;font-size:25rpx}.paper{background:#fffdf7;border:1rpx solid rgba(86,74,53,.08);border-radius:26rpx;box-shadow:0 12rpx 28rpx rgba(74,61,43,.08)}.note-paper{position:relative;min-height:610rpx;overflow:hidden}.paper-hole{position:absolute;left:20rpx;width:20rpx;height:20rpx;border-radius:50%;background:#ded5c5;box-shadow:inset 0 2rpx 4rpx rgba(60,45,28,.18)}.note-content{margin-left:56rpx;padding:50rpx 28rpx 0 26rpx;border-left:2rpx solid rgba(220,130,115,.28)}.section-title{font-family:"STKaiti","KaiTi",serif;font-size:38rpx;font-weight:700}.note-input{width:100%;height:390rpx;margin-top:22rpx;padding:18rpx 8rpx;font-family:"STKaiti","KaiTi",serif;font-size:32rpx;line-height:72rpx;background:repeating-linear-gradient(transparent 0,transparent 70rpx,rgba(110,100,84,.15) 71rpx,transparent 72rpx)}.placeholder{color:#aaa399}.meta-row{height:126rpx;border-top:1rpx solid #e8e1d5}.meta-row picker{width:46%}.meta-divider{width:1rpx;height:76rpx;background:#e8e1d5}.meta-item{display:flex;flex-direction:column;align-items:center}.meta-label{color:#70896d;font-size:25rpx;margin-bottom:10rpx}.meta-value{font-family:"STKaiti","KaiTi",serif;font-size:32rpx}.save-button{height:104rpx;line-height:104rpx;margin:32rpx 0;border-radius:54rpx;background:#e9684d;color:#fff;font-family:"STKaiti","KaiTi",serif;font-size:40rpx;box-shadow:0 12rpx 20rpx rgba(218,92,67,.2)}.week-card{padding:30rpx 24rpx 26rpx}.week-head{padding:0 6rpx 22rpx;border-bottom:1rpx solid #eee7da;font-family:"STKaiti","KaiTi",serif;font-size:30rpx}.accent{color:#e9684d;font-size:40rpx}.week-tip{color:#71866e;font-size:24rpx}.week-grid{display:flex;justify-content:space-between;padding-top:22rpx}.week-day{width:13.5%;display:flex;flex-direction:column;align-items:center;gap:8rpx;color:#4d4942}.week-day.today{color:#e9684d}.week-date{font-size:20rpx}.day-dot{width:42rpx;height:42rpx;line-height:40rpx;text-align:center;border:2rpx solid #cfc5b5;border-radius:50%;color:white}.day-dot.done{background:#7e927b;border-color:#7e927b}.today .day-dot.done{background:#e9684d;border-color:#e9684d}.today-list{margin-top:38rpx}.list-heading{font-family:"STKaiti","KaiTi",serif;font-size:32rpx;font-weight:700}.record-row{padding:22rpx 4rpx;border-bottom:1rpx solid rgba(90,75,54,.12)}.record-content{max-width:500rpx;font-size:28rpx;line-height:1.55}.record-time{margin-top:8rpx;color:#817d74;font-size:22rpx}.record-duration{color:#e9684d;font-size:24rpx}
.save-button{display:flex;align-items:center;justify-content:center;line-height:1;padding:0}.custom-duration-row{height:82rpx;display:flex;align-items:center;justify-content:center;gap:12rpx;border-top:1rpx solid #e8e1d5;color:#70896d;font-size:25rpx}.custom-duration-row input{width:120rpx;height:56rpx;text-align:center;border:1rpx solid #d8cfbf;border-radius:14rpx;background:#fff;color:#292824;font-size:28rpx}
